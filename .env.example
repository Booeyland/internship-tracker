# Local SQLite file (default). Override to relocate the database.
DATABASE_FILE=./data/tracker.db

# Optional Supabase / Postgres target. See supabase/schema.sql for the
# equivalent Postgres schema. Leaving these unset keeps the app on SQLite.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
